# Copy to .env and export before running server.py. Never commit .env.
PORT=8402
FREE_CALLS_PER_DAY=3

# Where the money goes. Required for anything but a dry run.
X402_PAY_TO=

# Base mainnet USDC by default.
X402_NETWORK=eip155:8453
X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_ASSET_NAME=USD Coin
X402_ASSET_VERSION=2
X402_PRICE_UNITS=10000
X402_CALLS_PER_PAYMENT=5000
X402_TIMEOUT_SECONDS=60

# Leave both empty to run in dry-run mode.
FACILITATOR_URL=
FACILITATOR_API_KEY=

# USDC on Arc through Circle Gateway. No key. The GatewayWallet address, EIP-712
# domain and minimum validity are read from Gateway's /supported at startup.
ARC_ENABLED=
ARC_NETWORK=eip155:5042
ARC_USDC=0x3600000000000000000000000000000000000000
ARC_GATEWAY_URL=https://gateway-api.circle.com/v1/x402
# 1 = verify Arc signatures locally instead of settling at Gateway.
ARC_DRY_RUN=
